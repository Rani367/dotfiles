// Zed settings
{
  "agent": {
    "dock": "right"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "fast": false,
        "mode": "bypassPermissions",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "button": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false
  },
  "title_bar": {
    "show_branch_name": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 23,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 23,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "format_on_save": "on",
  "formatter": "language_server",
  "lsp": {
    "basedpyright": {
      "settings": {
        "python": {
          "pythonPath": "python3"
        },
        "basedpyright.analysis": {
          "diagnosticMode": "openFilesOnly",
          "typeCheckingMode": "standard"
        }
      }
    },
    "clangd": {
      "binary": {
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--header-insertion=iwyu"
        ]
      }
    }
  },
  "languages": {
    "CSharp": {
      "formatter": {
        "external": {
          "command": "dotnet",
          "arguments": [
            "csharpier",
            "--write-stdout"
          ]
        }
      }
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    }
  }
}
